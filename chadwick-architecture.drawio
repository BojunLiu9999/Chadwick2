        <mxCell id="lg_safety" value="red border = safety / authoritative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;strokeWidth=2;" vertex="1" parent="legend">
