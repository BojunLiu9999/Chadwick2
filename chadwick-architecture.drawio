          <mxGeometry x="780" y="960" width="880" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rl_dds" value="CycloneDDS&#xa;NIC eno3 · 192.168.123.222/24&#xa;robot 192.168.123.164&#xa;&#xa;topics:&#xa;  rt/lowstate  →  bridge subscriber&#xa;  rt/bmsstate  →  bridge subscriber&#xa;  loco / arm cmds  ←  subprocess publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="rl">
          <mxGeometry x="20" y="40" width="320" height="195" as="geometry" />
        </mxCell>
        <mxCell id="rl_g1" value="G1 onboard&#xa;&#xa;• LocoClient API   (sport_mode required: R2+A)&#xa;• G1ArmActionClient&#xa;• 23 motors · IMU · BMS · camera&#xa;&#xa;Telemetry sources read here:&#xa;  IMU.rpy  ·  motor_state.tau_est  ·&#xa;  motor temps (coil,MOS) ·  bms.soc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="rl">
          <mxGeometry x="360" y="40" width="320" height="195" as="geometry" />
        </mxCell>
        <mxCell id="rl_hh" value="Handheld controller&#xa;&#xa;R2 + A → enter sport_mode&#xa;(required before any locomotion)&#xa;&#xa;L2 + B → EMERGENCY DAMP&#xa;(authoritative E-Stop;&#xa;UI E-Stop is soft &amp; needs LocoClient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="rl">
          <mxGeometry x="700" y="40" width="160" height="195" as="geometry" />
