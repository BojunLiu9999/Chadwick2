        <!-- ====== PERSISTENCE ====== -->
        <mxCell id="db" value="PERSISTENCE" style="swimlane;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;startSize=30;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
