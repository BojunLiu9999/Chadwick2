        </mxCell>
        <mxCell id="cmd_note" value="Each invocation:&#xa;fresh process → ChannelFactoryInitialize → publish one DDS cmd → exit&#xa;(~1–3 s cold start; deliberate trade-off)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=2;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="be_cmds">
