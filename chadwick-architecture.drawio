        </mxCell>
        <mxCell id="be_factory" value="services/__init__.py — FACTORY&#xa;picks bridge from ROBOT_MODE&#xa;⚠ `from services import robot`  (not `import mock_robot`)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="be_services">
