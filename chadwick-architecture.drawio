        <mxCell id="lg_ws" value="dashed = WebSocket / async stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;dashed=1;" vertex="1" parent="legend">
          <mxGeometry x="240" y="28" width="210" height="20" as="geometry" />
