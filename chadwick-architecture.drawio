        <mxCell id="lg_a" value="PATH A — in-process bridge (status/telemetry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="legend">
          <mxGeometry x="10" y="28" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_b" value="PATH B — subprocess sidecars (loco/arm cmds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="legend">
          <mxGeometry x="10" y="52" width="220" height="20" as="geometry" />
