        <!-- Sidecars -> SDK -->
        <mxCell id="e_cmd_sdk" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="be_cmds" target="ext_sdk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ====== LEGEND ====== -->
        <mxCell id="legend" value="Legend" style="swimlane;rounded=1;fillColor=#ffffff;strokeColor=#666666;startSize=22;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="460" height="80" as="geometry" />
