<mxfile host="app.diagrams.net" modified="2026-05-27T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="chadwick-arch-highlevel" name="Chadwick II — High Level">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Chadwick II — High-Level Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="36" as="geometry" />
        </mxCell>

        <!-- Users -->
        <mxCell id="users" value="Operator  /  Supervisor&#xa;(browser, same room as robot)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="fe" value="FRONTEND&#xa;React + Vite&#xa;&#xa;Operator console · Supervisor safety editor&#xa;Telemetry charts · Camera · Alert toasts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="be" value="BACKEND&#xa;FastAPI + Uvicorn" style="swimlane;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;startSize=34;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="1000" height="240" as="geometry" />
        </mxCell>

        <mxCell id="be_api" value="API &amp; WebSocket Layer&#xa;&#xa;JWT auth · REST routes&#xa;WS: telemetry · camera · voice&#xa;Audit log + safety enforcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="be">
          <mxGeometry x="30" y="50" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="be_pathA" value="Control Path A&#xa;In-process Bridge&#xa;&#xa;Long-lived LocoClient&#xa;Telemetry subscriptions&#xa;Connect · Arm · E-Stop · Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2F5B2F;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="be">
          <mxGeometry x="350" y="50" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="be_pathB" value="Control Path B&#xa;Subprocess Sidecars&#xa;&#xa;One process per click&#xa;Locomotion (F/B/L/R)&#xa;Arm gestures · Dance · Voice walk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#7A3E00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="be">
          <mxGeometry x="670" y="50" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- SQLite -->
        <mxCell id="db" value="SQLite&#xa;chadwick.db&#xa;&#xa;users · sessions&#xa;audit log · telemetry samples&#xa;safety config" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Robot -->
        <mxCell id="robot" value="Unitree G1 EDU&#xa;(over CycloneDDS, 192.168.123.x)&#xa;&#xa;LocoClient · ArmAction · IMU · BMS · Camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="710" width="400" height="140" as="geometry" />
