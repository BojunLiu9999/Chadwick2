        <!-- Handheld -> Robot (authoritative) -->
        <mxCell id="e_hh_r" value="authoritative E-Stop" style="endArrow=classic;html=1;strokeColor=#B85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#B85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hh" target="robot">
