          <mxGeometry x="960" y="710" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- Users -> Frontend -->
        <mxCell id="e_u_fe" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="users" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend -> Backend API : REST + WS -->
        <mxCell id="e_fe_be" value="HTTPS  /api/*&#xa;WSS  /api/ws/*" style="endArrow=classic;html=1;startArrow=classic;startFill=1;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fe" target="be_api">
