        <mxCell id="lg_a" value="Path A — in-process bridge  (telemetry + status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2F5B2F;fontSize=10;strokeWidth=2;" vertex="1" parent="lg">
