        <mxCell id="lg_b" value="Path B — subprocess per command  (motion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#7A3E00;fontSize=10;strokeWidth=2;" vertex="1" parent="lg">
