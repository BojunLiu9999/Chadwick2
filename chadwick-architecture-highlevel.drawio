          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Path A <-> Robot (subscribe telemetry) -->
        <mxCell id="e_a_r" value="DDS subscribe&#xa;rt/lowstate · rt/bmsstate" style="endArrow=classic;html=1;startArrow=classic;startFill=1;endFill=1;strokeColor=#2F5B2F;strokeWidth=2;fontSize=11;fontStyle=2;fontColor=#2F5B2F;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="be_pathA" target="robot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Path B -> Robot (publish commands) -->
        <mxCell id="e_b_r" value="DDS publish&#xa;loco / arm cmds" style="endArrow=classic;html=1;strokeColor=#7A3E00;strokeWidth=2;fontSize=11;fontStyle=2;fontColor=#7A3E00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="be_pathB" target="robot">
          <mxGeometry relative="1" as="geometry" />
