APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=chadwick-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=sqlite+aiosqlite:///./chadwick.db

ROBOT_MODE=real
ROBOT_IFACE=eno3
ROBOT_DOMAIN_ID=0
ROBOT_PYTHON_BIN=python3
ROBOT_SDK_PYTHONPATH=/home/capstone-cs47-3/unitree_sdk2_python
ROBOT_AUDIO_WAV=

FRONTEND_URL=http://localhost:5173

CAMERA_MODE=unitree_sdk
CAMERA_STREAM_URL=
CAMERA_LABEL=HEAD_CAM_01
CAMERA_RESOLUTION=1280x720
CAMERA_FPS=2
CAMERA_INTERFACE=eno3
CAMERA_PYTHON_BIN=
CAMERA_PYTHONPATH=/home/capstone-cs47-3/unitree_sdk2_python
CAMERA_SDK_CLIENT_IMPORT=unitree_sdk2py.go2.video.video_client:VideoClient
CAMERA_COMMAND_TIMEOUT=8

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Azure VoiceLive (wake-word voice chat). Endpoint is the wss:// URL from your
# tutor. Paste the api-key only into your local .env (gitignored), never here.
AZURE_VOICE_LIVE_ENDPOINT=
AZURE_VOICE_LIVE_API_KEY=
AZURE_VOICE_LIVE_MODEL=gpt-4o-realtime-preview
AZURE_VOICE_LIVE_VOICE=alloy
AZURE_VOICE_LIVE_WAKE_WORD=Chadwick

# Voice-triggered movement gate. Operator must say this phrase to unlock
# locomotion via voice. Set this in your local .env, never here. Leave empty
# to disable voice-driven movement entirely (slow_dance still works).
VOICE_MOVE_PASSWORD=
VOICE_UNLOCK_TIMEOUT_S=60
VOICE_STEP_SEC=1.0
