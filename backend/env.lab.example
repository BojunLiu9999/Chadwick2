APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=chadwick-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=sqlite+aiosqlite:///./chadwick.db

# Real Unitree G1 robot connection
ROBOT_MODE=real
ROBOT_IFACE=eno3
ROBOT_DOMAIN_ID=0
ROBOT_PYTHON_BIN=python3
ROBOT_SDK_PYTHONPATH=/home/capstone-cs47-3/unitree_sdk2_python
ROBOT_AUDIO_WAV=

FRONTEND_URL=http://localhost:5173

# G1 built-in front camera via Unitree SDK VideoClient
CAMERA_MODE=unitree_sdk
CAMERA_STREAM_URL=
CAMERA_LABEL=G1_FRONT_CAMERA
CAMERA_RESOLUTION=320x180
CAMERA_FPS=300
CAMERA_INTERFACE=eno3
CAMERA_PYTHON_BIN=python3
CAMERA_PYTHONPATH=/home/capstone-cs47-3/unitree_sdk2_python
CAMERA_SDK_CLIENT_IMPORT=unitree_sdk2py.go2.video.video_client:VideoClient
CAMERA_COMMAND_TIMEOUT=8

# ROS2 camera topic discovered on robot:
# /frontvideostream
# Type: unitree_go/msg/Go2FrontVideoData
# Fields: time_frame, video720p, video360p, video180p
